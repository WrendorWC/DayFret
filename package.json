{
  "name": "dayfret",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--max-http-header-size=65536 vite --host 127.0.0.1 --port 5192 --strictPort",
    "build": "tsc -b && vite build",
    "build:chords": "tsc -b && vite build --config vite.chords.config.ts && node scripts/make-standalone.mjs",
    "preview": "NODE_OPTIONS=--max-http-header-size=65536 vite preview"
  },
  "dependencies": {
    "pdfjs-dist": "^5.4.624",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "soundfont-player": "^0.12.0",
    "vexflow": "^4.2.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
